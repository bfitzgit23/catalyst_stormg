#!/usr/bin/env bash
# Start AetherDE directly from a TTY, with no display manager.
# Usage: aether-xinit        (or put `exec aether-xinit` in ~/.bash_profile on tty1)
set -Eeuo pipefail

if [[ -n "${XDG_VTNR:-}" ]]; then
  exec startx /usr/bin/aether-session -- -nolisten tcp "vt${XDG_VTNR}"
fi
exec startx /usr/bin/aether-session -- -nolisten tcp
