#!/bin/sh
# squall-session — the StormG desktop session.
#
# Starts ONLY the Xfce substrate Squall still needs, then hands the session to
# the Squall shell. Everything the user sees (bar, dock, launcher, files,
# settings, notifications surface) is Squall; xfce4-session and xfce4-panel are
# deliberately not used.
#
#   xfsettingsd   XSETTINGS daemon — GTK apps read theme/font/cursor through it
#   xfwm4         window manager + compositor (no replacement exists yet)
#   xfce4-notifyd implements org.freedesktop.Notifications on the session bus
#   squall       the shell; when it exits, the session ends
#
# Diagnostics: every component logs into $HOME/.squall/session.log. If the
# session fails to come up, that file (plus /var/log/lightdm/) is what to send.
#
set -u

# A dead greeter loop with zero output is the worst working mode. Every spawned
# component appends into this file from here on.
_TARGET="$HOME/.squall/session.log"
mkdir -p "$HOME/.squall" 2>/dev/null || true
if ! touch "$_TARGET" 2>/dev/null; then
    _TARGET=/tmp/squall-session.log
fi
{
    echo "---- squall-session start $(date -Is 2>/dev/null || date) ----"
    echo "user=$(id -un)  DISPLAY=${DISPLAY:-unset}  HOME=${HOME:-unset}"
    echo "session_bus=${DBUS_SESSION_BUS_ADDRESS:+present}${DBUS_SESSION_BUS_ADDRESS:-missing}"
} >> "$_TARGET"

log() { echo "[session] $*" >> "$_TARGET"; }
bg()  { "$@" >> "$_TARGET" 2>&1 & }

# The stock lightdm Xsession does not start a session D-Bus, but the whole
# substrate (xfconf-query bindings, xfsettingsd, the polkit agent, notifyd)
# expects one. Re-execute once under dbus-run-session to get a private bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    if [ "${SQUALL_UNDER_DBUS_SESSION:-0}" = 1 ]; then
        # Safeguard against an unlikely re-exec loop: no way to get a bus —
        # log it and keep going degraded instead of dying invisibly.
        log "ERROR: still no session bus after dbus-run-session; continuing degraded"
    else
        export SQUALL_UNDER_DBUS_SESSION=1
        log "no session bus found; re-executing under dbus-run-session"
        exec dbus-run-session -- "$0"
    fi
elif [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    log "WARNING: dbus-run-session unavailable; xfconf/notifyd features degrade"
fi

export XDG_CURRENT_DESKTOP=Squall
export XDG_SESSION_DESKTOP=Squall
export DESKTOP_SESSION=Squall

# one XSETTINGS daemon, otherwise GTK apps fall back to unstyled defaults
bg xfsettingsd --daemon

# window manager: --replace takes over from any previous instance
bg xfwm4 --replace
sleep 0.4

# apps assume a notification server exists even if Storm draws the popups
if command -v xfce4-notifyd >/dev/null 2>&1; then
    log "starting xfce4-notifyd"
    bg xfce4-notifyd
else
    log "xfce4-notifyd not found"
fi

# pkexec-driven actions (GPU/CPU switching, governor fallback) need an
# authentication agent in the session — without one the password prompt
# cannot appear and the action fails instead of asking.
agent="$(command -v lxpolkit 2>/dev/null || true)"
if [ -z "$agent" ]; then
    for candidate in         /usr/libexec/polkit-gnome-authentication-agent-1         /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
        [ -x "$candidate" ] && { agent=$candidate; break; }
    done
fi
if [ -n "$agent" ]; then
    log "starting polkit agent: $agent"
    bg "$agent"
else
    log "no polkit agent found; pkexec actions will not prompt"
fi

# system bridge for the shell (files, system stats, xfconf, launch)
if ! curl -sf --max-time 1 http://127.0.0.1:9876/api/health >/dev/null 2>&1; then
    log "starting squalld backend on :9876"
    bg python3 /usr/lib/squall/backend/squalld.py --port 9876
else
    log "squalld already healthy on :9876"
fi

# Hardware keys: bind the XF86 brightness (panel + keyboard) and volume keys to
# squalld, so a physical key and the Control Center share one code path.
bind_key() {
    command -v xfconf-query >/dev/null 2>&1 || return 0
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$1" -n -t string \
        -s "squall-key $2" >> "$_TARGET" 2>&1 \
      || xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$1" \
        -s "squall-key $2" >> "$_TARGET" 2>&1 \
      || log "binding $1 failed"
}

bind_key XF86MonBrightnessUp brightness-up
bind_key XF86MonBrightnessDown brightness-down
bind_key XF86KbdBrightnessUp kbdlight-up
bind_key XF86KbdBrightnessDown kbdlight-down
bind_key XF86AudioRaiseVolume volume-up
bind_key XF86AudioLowerVolume volume-down
bind_key XF86AudioMute volume-mute

# -- shell start-up, with a desktop as the failure mode ----------------------
# The session used to exec the shell and trust it: when the browser host was
# missing or Electron refused to start, the screen stayed black and the log was
# the only evidence. Start it in the background instead, give it
# SQUALL_BOOT_TIMEOUT seconds to prove it is up, and otherwise hand the session
# to the stock XFCE manager so the user still gets a desktop.
#
# "Up" is the launcher's own readiness marker: it writes $SQUALL_READY once it
# has a host process (browser or Electron) to draw the shell with. That beats
# guessing from the process tree, and a launcher that dies on the way there is
# detected separately.
BOOT_TIMEOUT="${SQUALL_BOOT_TIMEOUT:-8}"
export SQUALL_READY="${SQUALL_READY:-${XDG_RUNTIME_DIR:-$HOME/.squall}/squall.ready}"
rm -f "$SQUALL_READY" 2>/dev/null || true

shell_up() {
    kill -0 "$shell_pid" 2>/dev/null || return 1
    [ -e "$SQUALL_READY" ]
}

fallback_to_xfce() {
    log "squall did not come up; falling back to the stock XFCE session"
    kill "$shell_pid" 2>/dev/null || true
    wait "$shell_pid" 2>/dev/null || true
    rm -f "$SQUALL_READY" 2>/dev/null || true
    if ! command -v xfce4-session >/dev/null 2>&1; then
        log "xfce4-session is not installed: no desktop to fall back to"
        return 1
    fi
    # The substrate is already running; hand it to the stock manager under
    # XFCE's own identity rather than Squall's.
    export XDG_CURRENT_DESKTOP=XFCE
    export XDG_SESSION_DESKTOP=xfce
    export DESKTOP_SESSION=xfce
    log "exec xfce4-session"
    exec xfce4-session >> "$_TARGET" 2>&1
}

log "handing session to squall (fallback to XFCE after ${BOOT_TIMEOUT}s)"
squall >> "$_TARGET" 2>&1 &
shell_pid=$!

deadline=$(( $(date +%s) + BOOT_TIMEOUT ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if shell_up; then
        log "squall is up (pid $shell_pid)"
        # A host that dies on its first frame is not a desktop either.
        sleep 1
        if ! kill -0 "$shell_pid" 2>/dev/null; then
            log "squall exited right after starting"
            fallback_to_xfce
            log "fallback unavailable; returning to the greeter"
            exit 1
        fi
        break
    fi
    if ! kill -0 "$shell_pid" 2>/dev/null; then
        log "squall exited before it came up"
        fallback_to_xfce
        log "fallback unavailable; returning to the greeter"
        exit 1
    fi
    sleep 0.3
done

if ! shell_up; then
    fallback_to_xfce
    log "fallback unavailable; returning to the greeter"
    exit 1
fi

# The shell owns the session from here on: when it exits, the session ends.
wait "$shell_pid"
status=$?
log "squall exited (status $status)"
exit "$status"
