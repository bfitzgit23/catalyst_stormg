HOME = Path.home()
AUTOSTART_FILE = HOME / ".config/autostart/stormg-welcome.desktop"
AUTOSTART_DISABLED_MARKER = HOME / ".stormg-autostart-disabled"
LIVE_MARKERS = [
    "/etc/livecd",
    "/etc/init.d/livecd",
    "/etc/conf.d/livecd",
    "/run/live",
    "/run/livecd",
    "/run/live/makerom",
]

# ============================================================
# Utilities
# ============================================================
def is_live_session():
    return any(Path(m).exists() for m in LIVE_MARKERS)

def find_terminal():
    for term in ["xfce4-terminal", "gnome-terminal", "xterm", "konsole"]:
        if shutil.which(term):
            return shutil.which(term)
    return None

def run_command(cmd, title="StormG", hold=True):
    if isinstance(cmd, list):
        cmd_str = " ".join(f'"{c}"' if " " in c else c for c in cmd)
    else:
        cmd_str = cmd

    if cmd_str.startswith("sudo") and shutil.which("pkexec"):
        cmd_str = cmd_str.replace("sudo", "pkexec", 1)
        try:
            subprocess.Popen(cmd_str, shell=True, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            pass

    term = find_terminal()
    if not term:
        QMessageBox.critical(None, "Terminal Error", "No terminal found.")
        return False

    term_name = os.path.basename(term)
    if hold:
        shell_cmd = f'bash -c "{cmd_str}; echo; echo \'Press Enter to close...\'; read"'
    else:
        shell_cmd = f'bash -c "{cmd_str}"'

    if term_name == "gnome-terminal":
        args = [term, "--title", title, "--", "bash", "-c", shell_cmd]
    elif term_name == "xfce4-terminal":
        args = [term, "--disable-server", "--title", title, "--command", shell_cmd]
    elif term_name == "xterm":
        args = [term, "-title", title, "-e", shell_cmd]
    else:
        args = [term, "-e", shell_cmd]

    try:
        subprocess.Popen(args, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception as e:
        QMessageBox.critical(None, "Terminal Error", str(e))
        return False

def run_capture(cmd):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        return result.returncode, result.stdout, result.stderr
    except Exception:
        return 1, "", ""

# ============================================================
# Package backend (Portage)
# ============================================================
class PortageBackend:
    """Search/install/remove packages via portage tooling (eix, qlist, emerge)."""
    def search(self, query):
        rc, out, _ = run_capture(["eix", "-S", query])
        if rc != 0:
            return []
        packages = []
        current = None
        for line in out.split("\n"):
            line = line.strip()
            if line.startswith("*"):
                parts = line.split()
                if len(parts) < 2:
                    continue
                current = {
                    "name": parts[1], "version": "", "description": "",
                    "source": "portage", "installed": False,
                }
                packages.append(current)
            elif current is not None:
                low = line.lower()
                if low.startswith("available versions"):
                    toks = line.split()
                    current["version"] = " ".join(toks[2:4]) if len(toks) > 2 else ""
                elif "installed versions" in low:
                    current["installed"] = True
                elif low.startswith("description"):
                    current["description"] = line.split(":", 1)[1].strip() if ":" in line else ""
        return packages
    def get_installed(self):
        rc, out, _ = run_capture(["qlist", "-IC"])
        if rc != 0:
            return []
        return [
            {"name": n, "version": "", "description": "", "source": "portage", "installed": True}
            for n in out.split("\n") if n.strip()
        ]
    def install(self, pkg):
        run_command(["sudo", "emerge", "-v", "--autounmask-continue=y", pkg])
    def remove(self, pkg):
        run_command(["sudo", "emerge", "-C", pkg])

# ============================================================
# Main Window (tabs)
# ============================================================
class StormWelcome(QMainWindow):
    def __init__(self):
        super().__init__()
        self.is_live = is_live_session()
        self.selected_package = None
        self.init_ui()
        self.apply_styles()
        self.setup_autostart()
        self.animate_window()

    def init_ui(self):
        self.setWindowTitle("StormG Welcome")
        self.setMinimumSize(1000, 700)
        screen = QGuiApplication.primaryScreen().geometry()
        self.setGeometry(
            (screen.width() - 1000) // 2,
            (screen.height() - 700) // 2,
            1000, 700
        )

        central = QWidget()
        central.setObjectName("central")
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(20)

        layout.addWidget(self.create_header())

        self.tabs = QTabWidget()
        self.tabs.setObjectName("mainTabs")
        self.tabs.addTab(self.create_welcome_tab(), "Welcome")
        self.tabs.addTab(self.create_system_tab(), "System")
        self.tabs.addTab(self.create_software_tab(), "Software")
        self.tabs.addTab(self.create_maintenance_tab(), "Maintenance")
        self.tabs.addTab(self.create_drivers_tab(), "Drivers")
        self.tabs.addTab(self.create_tweaks_tab(), "Tweaks")
        self.tabs.addTab(self.create_gaming_tab(), "Gaming")
        self.tabs.addTab(self.create_settings_tab(), "Settings")
        self.tabs.addTab(self.create_help_tab(), "Help")
        layout.addWidget(self.tabs)

        layout.addWidget(self.create_footer())

    # ------------------------------------------------------------------
    # Header, Footer, Glass card helper
    # ------------------------------------------------------------------
    def create_header(self):
        header = QWidget()
        hlayout = QHBoxLayout(header)
        title = QLabel("StormG")
        title.setStyleSheet(f"font-size: 28px; font-weight: bold; color: {STORM_BLUE};")
        subtitle = QLabel("Gentoo made simple")
        subtitle.setStyleSheet(f"color: {STORM_GRAY}; font-size: 14px; margin-left: 12px;")
        hlayout.addWidget(title)
        hlayout.addWidget(subtitle)
        hlayout.addStretch()
        if self.is_live:
            badge = QLabel(" LIVE SESSION ")
            badge.setStyleSheet(f"background: {STORM_CORAL}; color: {STORM_DARK}; padding: 4px 12px; border-radius: 20px; font-weight: bold;")
            hlayout.addWidget(badge)
        return header

    def create_footer(self):
        footer = QWidget()
        flayout = QHBoxLayout(footer)
        self.status_label = QLabel("Ready")
        self.status_label.setStyleSheet(f"color: {STORM_GRAY}; font-size: 12px;")
        flayout.addWidget(self.status_label)
        flayout.addStretch()
        version = QLabel("v2.0 - Gentoo made simple")
        version.setStyleSheet(f"color: {STORM_GRAY}; font-size: 11px;")
        flayout.addWidget(version)
        return footer

