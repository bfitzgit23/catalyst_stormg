        header.addWidget(self.backend_status)
        layout.addLayout(header)

        search_layout = QHBoxLayout()
        self.soft_search = QLineEdit()
        self.soft_search.setPlaceholderText("Search packages (eix)...")
        self.soft_search.setObjectName("glassInput")
        search_layout.addWidget(self.soft_search)
        self.soft_source = QComboBox()
        self.soft_source.addItems(["Portage"])
        search_layout.addWidget(self.soft_source)
        search_btn = QPushButton("Search")
        search_btn.setObjectName("smallGlass")
        search_btn.clicked.connect(self.search_packages)
        search_layout.addWidget(search_btn)
        installed_btn = QPushButton("Installed")
        installed_btn.setObjectName("smallGlass")
        installed_btn.clicked.connect(self.show_installed)
        search_layout.addWidget(installed_btn)
        layout.addLayout(search_layout)

        splitter = QSplitter(Qt.Orientation.Horizontal)
        self.package_list = QTreeWidget()
        self.package_list.setHeaderLabels(["Name", "Version", "Source"])
        self.package_list.setColumnWidth(0, 250)
        self.package_list.setColumnWidth(1, 120)
        self.package_list.setObjectName("packageList")
        self.package_list.itemClicked.connect(self.on_package_selected)
        splitter.addWidget(self.package_list)

        details_widget = QWidget()
        details_layout = QVBoxLayout(details_widget)
        self.details_title = QLabel("Select a package")
        self.details_title.setStyleSheet("font-size: 16px; font-weight: bold; color: #64ffda;")
        details_layout.addWidget(self.details_title)
        self.details_text = QTextEdit()
        self.details_text.setReadOnly(True)
        self.details_text.setMaximumHeight(200)
        self.details_text.setObjectName("glassText")
        details_layout.addWidget(self.details_text)
        btn_layout = QHBoxLayout()
        self.install_btn = QPushButton("Install")
        self.install_btn.setObjectName("successGlass")
        self.install_btn.clicked.connect(self.install_package)
        self.install_btn.setEnabled(False)
        self.remove_btn = QPushButton("Remove")
        self.remove_btn.setObjectName("dangerGlass")
        self.remove_btn.clicked.connect(self.remove_package)
        self.remove_btn.setEnabled(False)
        btn_layout.addWidget(self.install_btn)
        btn_layout.addWidget(self.remove_btn)
        btn_layout.addStretch()
        details_layout.addLayout(btn_layout)
        splitter.addWidget(details_widget)
        splitter.setSizes([450, 350])
        layout.addWidget(splitter)
        return tab

    def search_packages(self):
        query = self.soft_search.text().strip()
        if not query:
            return
        self.package_list.clear()
        self.status_label.setText("Searching...")
        threading.Thread(target=self._do_search, args=(query,), daemon=True).start()

    def _do_search(self, query):
        packages = PortageBackend().search(query)
        QApplication.instance().postEvent(self, SearchResultsEvent(packages))

    def show_installed(self):
        self.package_list.clear()
        self.status_label.setText("Loading installed...")
        threading.Thread(target=self._do_load_installed, daemon=True).start()

    def _do_load_installed(self):
        packages = PortageBackend().get_installed()
        QApplication.instance().postEvent(self, SearchResultsEvent(packages))

    def on_package_selected(self, item, col):
        pkg = item.data(0, Qt.ItemDataRole.UserRole)
        self.selected_package = pkg
        self.details_title.setText(f"{pkg['name']} - {pkg['source']}")
        self.details_text.setText(pkg.get("description", "No description"))
        self.install_btn.setEnabled(not pkg.get("installed", False))
        self.remove_btn.setEnabled(pkg.get("installed", False))

    def install_package(self):
        if self.selected_package:
            PortageBackend().install(self.selected_package["name"])

    def remove_package(self):
        if self.selected_package:
            PortageBackend().remove(self.selected_package["name"])

