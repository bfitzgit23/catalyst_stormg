        layout.setContentsMargins(30, 30, 30, 30)
        layout.setSpacing(20)
        card = self.create_glass_card("System Actions")
        actions = [
            ("Update System (emerge -uDN @world)", ["sudo", "emerge", "-uDN", "--keep-going=y", "@world"]),
            ("Reboot", ["sudo", "reboot"]),
            ("Shutdown", ["sudo", "shutdown", "-h", "now"]),
