        card.setStyleSheet(f"""
            QGroupBox {{
                background-color: {GLASS_DARK};
                border: 1px solid rgba(100, 255, 218, 0.2);
                border-radius: 16px;
                margin-top: 12px;
                padding-top: 12px;
                font-weight: bold;
                color: {STORM_BLUE};
            }}
            QGroupBox::title {{
                subcontrol-origin: margin;
                left: 16px;
                padding: 0 8px;
            }}
        """)
        layout = QVBoxLayout(card)
        layout.setSpacing(12)
        return card

