#!/bin/sh
# stormg-timeshift-baseline - create the first Timeshift snapshot, once.
#
# Runs from the OpenRC service timeshift-initial-snapshot on the first boot of
# an installed StormG system, and is safe to run by hand. It stays away from
# small disks: it only creates the baseline when no snapshot exists yet and the
# filesystem can hold a full rsync copy of everything Timeshift includes.
#
# The outcome is recorded in /var/lib/timeshift-initial-snapshot.state and in
# /var/log/timeshift-initial-snapshot.log. Delete the state file to re-arm it.

set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

state=/var/lib/timeshift-initial-snapshot.state
conf=/etc/timeshift/timeshift.json
log=/var/log/timeshift-initial-snapshot.log

log_msg() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log"
    printf '%s\n' "$*"
}

record() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" > "$state"
    log_msg "$1"
}

if [ -e "$state" ]; then
    exit 0
fi

if [ ! -f "$conf" ]; then
    record "skipped: $conf is missing"
    exit 0
fi

if ! command -v timeshift >/dev/null 2>&1; then
    record "skipped: timeshift is not installed"
    exit 0
fi

uuid="$(sed -n 's/.*"backup_device_uuid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$conf" | head -n 1)"
if [ -z "$uuid" ]; then
    record "skipped: backup_device_uuid is empty in $conf"
    exit 0
fi

target="$(findmnt -no TARGET "UUID=${uuid}" 2>/dev/null | head -n 1)"
if [ -n "$target" ]; then
    target="${target%/}"
else
    target=/
fi

if [ -d "$target/timeshift/snapshots" ] \
        && [ -n "$(ls -A "$target/timeshift/snapshots" 2>/dev/null)" ]; then
    record "skipped: snapshots already exist in $target/timeshift/snapshots"
    exit 0
fi

avail="$(df -Pk / | awk 'NR==2 {print $4}')"
used="$(df -Pk / | awk 'NR==2 {print $3}')"
excluded=0
for path in /home /root /var/cache /var/tmp /var/log /var/db/repos /usr/src /timeshift; do
    [ -d "$path" ] || continue
    size="$(du -xsk "$path" 2>/dev/null | awk '{print $1}')"
    excluded=$((excluded + ${size:-0}))
done
included=$((used - excluded))
if [ "$included" -lt 0 ]; then
    included=0
fi
# 10% slack for rsync metadata and hard-link bookkeeping, plus 1 GiB headroom.
need=$((included * 11 / 10 + 1048576))

if [ "$avail" -lt "$need" ]; then
    record "skipped: need ${need} KiB free for the baseline, ${avail} KiB available"
    exit 0
fi

log_msg "creating baseline snapshot (${avail} KiB free, estimated ${need} KiB)"

if timeshift --create --comments "Initial StormG snapshot" --tags D --scripted >> "$log" 2>&1; then
    record "created: initial Timeshift snapshot"
else
    record "failed: timeshift --create returned nonzero, see $log"
    exit 1
fi
