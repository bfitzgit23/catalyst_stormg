# Maintainer: AetherDE Engineering <aetherde@local>
pkgname=aether-de
pkgver=0.1.0
pkgrel=1
pkgdesc='Web-native desktop environment for Arch Linux on XFCE4/X11 with a Python system bridge and a Node.js realtime gateway'
arch=('x86_64')
url='https://example.invalid/aether-de'
license=('MIT')
depends=(
  'xfwm4'
  'xfce4-settings'
  'xorg-server'
  'xorg-xinit'
  'xorg-xprop'
  'python'
  'python-xlib'
  'python-dbus-next'
  'python-psutil'
  'python-fastapi'
  'uvicorn'
  'nodejs'
  'npm'
  'electron'
  'picom'
  'polkit-gnome'
  'hicolor-icon-theme'
)
makedepends=('npm')
optdepends=(
  'zsh: preferred interactive shell for the built-in terminal'
  'bash: fallback interactive shell for the built-in terminal'
  'imagemagick: thumbnail generation in the file manager'
  'webkit2gtk: alternative web shell engine'
  'xorg-xrandr: display configuration applet'
)
source=(
  'bin/aether-session'
  'bin/aether-de'
  'src/aether_de'
  'gateway'
  'shell'
  'share/xsessions/aether-de.desktop'
  'systemd/aether-de.service'
  'README.md'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -d "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/lib/aether-de"
  install -d "$pkgdir/usr/share/xsessions"
  install -d "$pkgdir/usr/share/doc/$pkgname"
  install -d "$pkgdir/usr/lib/systemd/user"

  install -Dm755 "$srcdir/bin/aether-session" "$pkgdir/usr/bin/aether-session"
  install -Dm755 "$srcdir/bin/aether-de" "$pkgdir/usr/bin/aether-de"
  install -Dm644 "$srcdir/share/xsessions/aether-de.desktop" "$pkgdir/usr/share/xsessions/aether-de.desktop"
  install -Dm644 "$srcdir/systemd/aether-de.service" "$pkgdir/usr/lib/systemd/user/aether-de.service"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"

  cp -a "$srcdir/src/aether_de" "$pkgdir/usr/lib/aether-de/aether_de"
  cp -a "$srcdir/gateway" "$pkgdir/usr/lib/aether-de/gateway"
  cp -a "$srcdir/shell" "$pkgdir/usr/lib/aether-de/shell"

  find "$pkgdir/usr/lib/aether-de" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/lib/aether-de" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir/usr/lib/aether-de/gateway/server.js"
  chmod 755 "$pkgdir/usr/lib/aether-de/shell/electron-main.js"
}
