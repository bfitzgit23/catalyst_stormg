++        result.block_rows = 1;
++        result.block_cols = 64;
++    } else {
++        // row_split 1 means higher register use per row, so block size has to be adjusted
++        if (result.row_split == 1) {
++            result.block_rows = n_rows == 2 ? 2 : ((n_rows <= 4 || reduce_block_rows) ? 4 : 8);
++        } else {
