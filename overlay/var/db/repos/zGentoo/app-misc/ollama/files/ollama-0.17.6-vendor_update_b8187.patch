++            uint64_t      N       = node->ne[3];
++            uint64_t      Cout    = node->ne[2];
++            uint64_t      KW      = knl->ne[0];
++            uint64_t      KH      = knl->ne[1];
++            uint64_t      Cin     = node->src[1]->ne[2];
