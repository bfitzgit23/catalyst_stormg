#!/usr/bin/env bash
# Launch the StormOS installer on Gentoo. Electron is preferred when available;
# Gentoo's main repo has no electron atom, so firefox-bin is the normal fallback.
set -Eeuo pipefail

PORT=9877
BASE=/usr/lib/stormos-installer
LOG=/var/log/stormos-installer.log
URL="http://127.0.0.1:${PORT}/"

if [[ "$(id -u)" -ne 0 ]]; then
  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec /usr/bin/stormos-installer "$@"
  fi
  echo "Run stormos-installer as root" >&2
  exit 1
fi

ready() { curl -sf --max-time 1 "${URL}api/health" >/dev/null 2>&1; }

if ! ready; then
  nohup python3 "$BASE/backend/installerd.py" --port "$PORT" >>"$LOG" 2>&1 &
  for _ in $(seq 1 50); do
    ready && break
    sleep 0.1
  done
fi
if ! ready; then
  echo "StormOS installer backend failed; see $LOG" >&2
  exit 1
fi

export STORMOS_INSTALLER_URL="$URL"
if command -v electron >/dev/null 2>&1; then
  exec electron "$BASE/electron-main.js"
elif command -v firefox-bin >/dev/null 2>&1; then
  exec firefox-bin --new-window "$URL"
elif command -v firefox >/dev/null 2>&1; then
  exec firefox --new-window "$URL"
elif command -v chromium >/dev/null 2>&1; then
  exec chromium --new-window "$URL"
else
  echo "No suitable browser or Electron found for the installer GUI" >&2
  exit 1
fi
